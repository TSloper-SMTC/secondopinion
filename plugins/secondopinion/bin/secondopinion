#!/bin/bash
# secondopinion — global, concurrent, file-based mailbox for Codex→Claude review exchanges.
#
# Store layout (default ~/.secondopinion, override with SECONDOPINION_DIR):
#   exchanges/<ID>/prompt.md     requester writes (draft until `publish`)
#   exchanges/<ID>/meta          tool-owned state (key=value), authoritative
#   exchanges/<ID>/claim/        atomic claim by the responder (token + owner)
#   exchanges/<ID>/response.md   responder's answer, write-once, hash-bound in meta
#   archive/<ID>/                after the requester consumes the response
#
# States: draft -> published -> claimed -> answered -> archived
#
# Platform: Linux with GNU coreutils/util-linux and bash >= 4.3 (local -n, declare -A).
# /proc, flock(1), and GNU mv/du/stat/timeout semantics are load-bearing throughout.
set -euo pipefail
umask 077
command -v flock >/dev/null 2>&1 || { echo "ERROR: flock(1) (util-linux) not found on PATH; secondopinion requires Linux with GNU coreutils and util-linux." >&2; exit 1; }

VERSION="1.0.0"
warn() { echo "WARNING: $*" >&2; }

# ---- agent-mailbox compatibility (the tool's pre-release internal name) -----------------------
# The old command name works as a deprecated alias, the old AGENT_MAILBOX_* variables are
# honoured when the new SECONDOPINION_* ones are unset, and an un-migrated ~/.agent-mailbox
# store is used (never duplicated) until install.sh moves it. Each case warns once per run.
case "$(basename -- "$0")" in
    agent-mailbox) warn "'agent-mailbox' is a deprecated alias of 'secondopinion'; update your scripts and skills.";;
esac
legacy_env() { # NEW OLD
    if [ -z "${!1:-}" ] && [ -n "${!2:-}" ]; then
        warn "$2 is deprecated; use $1 (honouring $2 for now)."
        export "$1=${!2}"
    fi
}
legacy_env SECONDOPINION_DIR AGENT_MAILBOX_DIR
legacy_env SECONDOPINION_OWNER AGENT_MAILBOX_OWNER
legacy_env SECONDOPINION_STALE_CLAIM_SECS AGENT_MAILBOX_STALE_CLAIM_SECS

if [ -z "${SECONDOPINION_DIR:-}" ] && [ -z "${HOME:-}" ]; then
    echo "ERROR: neither SECONDOPINION_DIR nor HOME is set; cannot locate the exchange store." >&2
    exit 1
fi
if [ -n "${SECONDOPINION_DIR:-}" ]; then
    STORE="$SECONDOPINION_DIR"
elif [ -d "$HOME/.secondopinion" ] || [ ! -d "$HOME/.agent-mailbox" ]; then
    STORE="$HOME/.secondopinion"
else
    STORE="$HOME/.agent-mailbox"
    warn "using the legacy store $STORE; run install.sh to migrate it to $HOME/.secondopinion."
fi
EXCH="$STORE/exchanges"
ARCH="$STORE/archive"
# Seconds values (stale-claim threshold, wait timeout) are decimal, non-negative and bounded
# so they can never wrap in Bash arithmetic (2^64 would wrap to 0 and, e.g., permit takeover).
MAX_SECS=4294967295
parse_secs() { # name value -> prints the integer, or an error line on stderr and returns 1
    local v
    [[ "$2" =~ ^[0-9]+$ ]] || { echo "ERROR: $1 must be a non-negative decimal number of seconds no greater than $MAX_SECS (got '$2')." >&2; return 1; }
    v="${2#"${2%%[!0]*}"}"; [ -n "$v" ] || v=0        # strip leading zeros (any count) before the width check
    if [ "${#v}" -gt 10 ] || [ "$((10#$v))" -gt "$MAX_SECS" ]; then
        echo "ERROR: $1 must be a non-negative decimal number of seconds no greater than $MAX_SECS (got '$2')." >&2
        return 1
    fi
    echo $((10#$v))
}
STALE_CLAIM_SECS="$(parse_secs SECONDOPINION_STALE_CLAIM_SECS "${SECONDOPINION_STALE_CLAIM_SECS:-1800}")" || exit 1
LOCK_WAIT_SECS="$(parse_secs SECONDOPINION_LOCK_WAIT_SECS "${SECONDOPINION_LOCK_WAIT_SECS:-30}")" || exit 1
DEFAULT_WAIT_TIMEOUT=600
POLL_SECS=2
TASK_PLACEHOLDER_MARK="Replace this section with the focused request for"
MAX_HEADER_LINES=64

parse_count() { # name value -> positive integer (reuses parse_secs, then requires >= 1)
    local v; v="$(parse_secs "$1" "$2")" || return 1
    [ "$v" -ge 1 ] || { echo "ERROR: $1 must be at least 1" >&2; return 1; }
    printf '%s\n' "$v"
}

usage() {
    cat <<EOF
secondopinion $VERSION — sealed, verifiable second-opinion exchanges between coding agents (Codex→Claude Code)
Store: $STORE   (override: SECONDOPINION_DIR)

Requester (Codex) side:
  ask --topic TOPIC (--file REQ.md | --file - | --task TEXT) [--timeout S] [--write]
      [--background] [--model M] [--effort L] [--max-turns N] [--json] [--persist]
      [--follow-up ID | --resume ID] [--fresh]
  ask --attach ID [--write] [--model M] [--effort L] [--max-turns N] [--timeout S] [--background]
                          re-launch a headless responder for an EXISTING published exchange
                          (e.g. after a background responder died with its sandbox)
                          one call: create+publish the exchange, run a headless Claude Code
                          responder in this checkout (self-contained prompt, never prompts:
                          --permission-mode dontAsk + tool allowlist; --write = acceptEdits),
                          wait, validate and print the answer. exit 0 answered | 124 timeout |
                          1 error (exchange stays published for a retry). --background returns
                          the ID at once; then: jobs / wait ID / result ID / cancel ID.
                          --effort is validated against the live claude CLI. --follow-up ID
                          embeds the validated parent exchange in a NEW linked exchange
                          (stateless). --persist opts into a stored Claude session id so a
                          later ask --resume ID can continue that native session; the default
                          stays private (--no-session-persistence). --fresh is the default.
  review [--adversarial] [--base REF | --scope working-tree] [--task FOCUS] [--topic T]
         [+ ask options]  read-only code review of this checkout's working tree (or
                          REF...HEAD) with a structured verdict/findings JSON contract;
                          --adversarial challenges design choices and assumptions.
  review-result ID        parse the review's fenced JSON: exit 0 parse_ok=yes (verdict,
                          findings, canonical JSON) | 3 parse_ok=no with the full raw
                          response preserved | 1 validation error.
  jobs [--all|--repo P]   repository-scoped table: id, state, age, responder liveness
  result ID               validated answer (read-response), or an honest status + log path
  cancel ID               stop a background responder (verified pid+start time; the exchange
                          stays recoverable; a valid answer is never demoted)
  prune [--apply] [--retain N]
                          bounded retention over archive/ per repository (default keep
                          newest ${SECONDOPINION_RETAIN:-50}; dry-run unless --apply; pruned
                          IDs are tombstoned and never reused)
  new --topic TOPIC [--target NAME] [--requester NAME] [--parent ID]   create a draft exchange, print its ID
  publish ID              freeze prompt.md (records SHA-256); makes it visible as pending
  wait ID [--timeout S]   block until a valid response exists (default timeout $DEFAULT_WAIT_TIMEOUT s)
                          exit 0 answered | 124 timeout | 2 archived | 1 error
  read-response ID        validate and print the response
  archive ID [--force] [--prune]  move a consumed exchange to archive/ (idempotent); --prune (or
                          SECONDOPINION_AUTO_PRUNE=1) then prunes THIS repository's bucket to the
                          retention bound — bucket-only, fail-open (a prune failure never fails
                          the archive), reported as auto_prune=... on stdout

Responder (Claude) side:
  list [--pending|--answered|--drafts|--all] [--repo PATH|--here] [--json]
  show ID                 print prompt.md
  claim ID [--owner NAME] [--takeover]   atomically claim a published exchange, print claim_token
  respond ID --token TOKEN --file FILE   publish response (write-once); FILE must start
                          with 'Exchange-ID: ID' and contain a nonempty 'Responder:' line in
                          its header block (the lines before the first blank line)

Both:
  status ID [--json]      tool-owned state plus prompt_ok / response_ok validation
  path ID                 print the exchange directory
  help | --help

Environment: SECONDOPINION_DIR, SECONDOPINION_OWNER (default claim owner),
             SECONDOPINION_STALE_CLAIM_SECS (default 1800; --takeover allowed after this),
             SECONDOPINION_LOCK_WAIT_SECS (default 30; error instead of waiting longer for a held exchange lock),
             SECONDOPINION_CLAUDE (responder binary, default: claude), SECONDOPINION_CLAUDE_ARGS
             (extra flags appended to the responder command), SECONDOPINION_MAX_TURNS (default 60),
             SECONDOPINION_ASK_TIMEOUT (default 1800), SECONDOPINION_RETAIN (prune bound, default 50),
             SECONDOPINION_AUTO_PRUNE (nonempty and not 0/false/no: archive auto-prunes its own bucket)
EOF
}

RESP_TMP=""
die() { echo "ERROR: $*" >&2; exit 1; }
now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
epoch() { date +%s; }
sha() { sha256sum "$1" | cut -d' ' -f1; }
regular() { [ -f "$1" ] && [ ! -L "$1" ]; }

valid_id() {
    local id="$1"
    [ "${#id}" -le 100 ] || return 1
    [[ "$id" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-[a-z0-9][a-z0-9-]*$ ]] || return 1
    case "$id" in *..*|*/*) return 1;; esac
    return 0
}

require_id() { valid_id "${1:-}" || die "invalid exchange id: '${1:-}'"; }

# Containment: an exchange directory and every tool-owned component inside it
# must be real (non-symlink) filesystem objects. A symlinked exchange dir,
# .lock, meta, or claim/ is refused by every command so nothing outside the
# store is ever read, written, locked, or moved.
real_dir() { [ -d "$1" ] && [ ! -L "$1" ]; }
check_components() { # dir
    local c
    for c in .lock meta claim prompt.md response.md; do
        [ -L "$1/$c" ] && die "refusing symlinked $c in exchange $(basename "$1")"
    done
    return 0
}
is_active() { real_dir "$EXCH/$1"; }
is_archived() { real_dir "$ARCH/$1"; }
# Resolve exchange dir: active first, then archive. Prints dir; sets IS_ARCHIVED.
IS_ARCHIVED=0
exdir() {
    require_id "$1"
    if is_active "$1"; then IS_ARCHIVED=0; check_components "$EXCH/$1"; echo "$EXCH/$1"; return 0; fi
    if is_archived "$1"; then IS_ARCHIVED=1; check_components "$ARCH/$1"; echo "$ARCH/$1"; return 0; fi
    [ -L "$EXCH/$1" ] || [ -L "$ARCH/$1" ] && die "refusing symlinked exchange directory: $1"
    die "unknown exchange: $1"
}
active_dir() {
    require_id "$1"
    if is_active "$1"; then check_components "$EXCH/$1"; echo "$EXCH/$1"; return 0; fi
    [ -L "$EXCH/$1" ] && die "refusing symlinked exchange directory: $1"
    is_archived "$1" && die "exchange is archived: $1"
    die "unknown exchange: $1"
}
# Values stored in meta / headers: printable, no newlines or control characters (tab allowed).
safe_value() { # name value
    case "$2" in *[![:print:][:blank:]]*) die "$1 must not contain control characters or newlines";; esac
    case "$2" in *$'\n'*|*$'\r'*) die "$1 must not contain newlines";; esac
    return 0
}
trim() { printf '%s' "$1" | sed -E 's/[[:space:]]+$//; s/^[[:space:]]+//'; }
# Header block of prompt.md / response.md = the lines before the first blank line
# (or the whole file if it has none), at most MAX_HEADER_LINES. Every header value is
# taken from this block only, so a `Responder:` line in the body does not count and a
# line beyond the first blank line is never validated by mistake. The block may use
# CRLF line endings, and TAB is allowed, but no other control byte may appear: an
# embedded CR, NUL or ESC would be silently dropped or hidden by shell extraction
# (tr/command substitution) while remaining in the hash-approved file. Bytes are
# checked in the C locale BEFORE any command substitution, so NUL is caught and UTF-8
# text passes. An oversized (or unterminated beyond the bound) header is rejected,
# never silently truncated.
header_block() { # file -> CR-stripped header lines through the first blank line (bounded)
    LC_ALL=C sed -e 's/\r$//' -e '/^$/q' -- "$1" 2>/dev/null | head -n $((MAX_HEADER_LINES + 2))
}
header_records() { # file -> number of header records (a terminating blank line is not a record;
                   #         an unterminated final line is; EOF-safe: grep -c '' counts partial lines)
    local total last
    total="$(header_block "$1" | grep -c '')"
    last="$(header_block "$1" | tail -n1)"
    if [ "$total" -gt 0 ] && [ -z "$last" ]; then echo $((total - 1)); else echo "$total"; fi
}
# header_check file -> prints "" (clean) or the reason; callers die with it.
header_check() {
    regular "$1" || { echo "file is missing or not a regular file"; return 0; }
    [ "$(header_records "$1")" -le "$MAX_HEADER_LINES" ] || { echo "header block has more than $MAX_HEADER_LINES lines before the first blank line (records 1-$MAX_HEADER_LINES are accepted; record $((MAX_HEADER_LINES + 1)) is refused whether the block ends with a blank line, EOF or an unterminated line)"; return 0; }
    header_block "$1" | LC_ALL=C sed 's/\t//g' | LC_ALL=C grep -aq '[[:cntrl:]]' && { echo "header block contains control bytes (embedded CR, NUL, ESC...); CRLF line endings and TAB are allowed"; return 0; }
    echo ""
}
header_ok() { [ -z "$(header_check "$1")" ]; }
# Exactly one positional argument (the exchange ID) is accepted; a second one is an
# error rather than silently replacing the first.
positional() { # varname value
    local -n _slot="$1"
    [ -z "$_slot" ] || die "unexpected extra argument: '$2' (only one exchange ID is accepted)"
    _slot="$2"
}

# ---- meta (key=value) ------------------------------------------------------
meta_get() { # dir key
    [ -L "$1/meta" ] && die "refusing symlinked meta in $(basename "$1")"
    [ -f "$1/meta" ] || return 0
    awk -v k="$2" -F= '$1==k{sub(/^[^=]*=/,""); print; exit}' "$1/meta"
}
meta_set() { # dir key value [key value ...]  (atomic rewrite; caller holds lock)
    local dir="$1"; shift
    local tmp="$dir/.meta.tmp.$$"
    declare -A kv=()
    local order=()
    if [ -f "$dir/meta" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            local k="${line%%=*}"
            kv["$k"]="${line#*=}"; order+=("$k")
        done < "$dir/meta"
    fi
    while [ "$#" -ge 2 ]; do
        [ -n "${kv[$1]+x}" ] || order+=("$1")
        kv["$1"]="$2"; shift 2
    done
    : > "$tmp"
    local k
    for k in "${order[@]}"; do printf '%s=%s\n' "$k" "${kv[$k]}" >> "$tmp"; done
    mv -f "$tmp" "$dir/meta"
    sync -- "$dir/meta" 2>/dev/null || true   # meta is authoritative; best-effort durability (coreutils >=8.24)
}
lock() {
    [ -L "$1/.lock" ] && die "refusing symlinked .lock in $(basename "$1")"
    exec 9>>"$1/.lock"
    flock -w "$LOCK_WAIT_SECS" 9 || die "exchange busy: lock on $(basename "$1") still held after ${LOCK_WAIT_SECS}s (another secondopinion command is stuck or slow; SECONDOPINION_LOCK_WAIT_SECS adjusts the wait)"
}
unlock() { exec 9>&-; }

# ---- validation ------------------------------------------------------------
prompt_ok() { # dir -> yes|no|n/a
    local dir="$1" state want
    state="$(meta_get "$dir" state)"
    case "$state" in draft|"") echo "n/a"; return;; esac
    want="$(meta_get "$dir" prompt_sha256)"
    if regular "$dir/prompt.md" && [ -n "$want" ] && [ "$(sha "$dir/prompt.md")" = "$want" ] \
       && header_ok "$dir/prompt.md"; then echo yes; else echo no; fi
}
response_ok() { # dir -> yes|no|n/a
    local dir="$1" state want id
    state="$(meta_get "$dir" state)"
    case "$state" in answered|archived) ;; *) echo "n/a"; return;; esac
    want="$(meta_get "$dir" response_sha256)"; id="$(meta_get "$dir" exchange_id)"
    if regular "$dir/response.md" && [ -n "$want" ] && [ "$(sha "$dir/response.md")" = "$want" ] \
       && header_ok "$dir/response.md" \
       && [ "$(head -n1 "$dir/response.md" | tr -d '\r')" = "Exchange-ID: $id" ]; then echo yes; else echo no; fi
}

# ---- git helpers -----------------------------------------------------------
git_common_of() { # path -> realpath of git common dir, or "" if not a repo
    local top common
    top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 0
    common="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 0
    ( cd "$1" && realpath -m "$common" )
}
human_age() { # seconds
    local s="$1"
    if [ "$s" -lt 60 ]; then echo "${s}s"; elif [ "$s" -lt 3600 ]; then echo "$((s/60))m"; elif [ "$s" -lt 86400 ]; then echo "$((s/3600))h"; else echo "$((s/86400))d"; fi
}
json_str() { # escape for JSON (all control characters)
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"; s="${s//$'\b'/\\b}"; s="${s//$'\f'/\\f}"
    s="$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177')"
    printf '"%s"' "$s"
}

ensure_store() {
    if ! mkdir -p "$STORE" "$EXCH" "$ARCH" 2>/dev/null; then
        echo "ERROR: cannot create mailbox store $STORE (read-only or no permission)." >&2
        echo "       Under a Codex workspace-write sandbox the store must be a writable root:" >&2
        echo "       ~/.codex/config.toml -> [sandbox_workspace_write] writable_roots = [\"$STORE\"]" >&2
        echo "       (~/tools/secondopinion/scripts/install.sh adds it; or set SECONDOPINION_DIR to a writable path)." >&2
        exit 1
    fi
    chmod 700 "$STORE" "$EXCH" "$ARCH" 2>/dev/null || true
}

# ---- tombstones: durable reservation of pruned exchange IDs ---------------
TOMB="$STORE/tombstones"
tombstoned() { [ -f "$TOMB" ] && [ ! -L "$TOMB" ] && grep -Fxq -- "$1" "$TOMB" 2>/dev/null; }

# ---- commands --------------------------------------------------------------
cmd_new() {
    local topic="" target="Claude Code" requester="Codex" parent=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --topic) [ "$#" -ge 2 ] || die "--topic requires a value"; topic="$2"; shift 2;;
            --target) [ "$#" -ge 2 ] || die "--target requires a value"; target="$2"; shift 2;;
            --requester) [ "$#" -ge 2 ] || die "--requester requires a value"; requester="$2"; shift 2;;
            --parent) [ "$#" -ge 2 ] || die "--parent requires an exchange ID"; parent="$2"; shift 2;;
            -h|--help) usage; exit 0;;
            *) die "unknown new option: $1";;
        esac
    done
    [ -z "$parent" ] || require_id "$parent"
    [ -n "$topic" ] || die "new requires --topic TOPIC"
    safe_value "--topic" "$topic"; safe_value "--target" "$target"; safe_value "--requester" "$requester"
    local slug
    slug="$(printf '%s' "$topic" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-60)"
    [ -n "$slug" ] || slug="exchange"

    # Derive and validate every header/meta value BEFORE reserving an exchange
    # directory: an unsafe repository path or CODEX_THREAD_ID must not create a
    # half-formed exchange, and no derived value may inject header/meta lines.
    local repo common branch commit dirty
    repo="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -n "$repo" ]; then
        common="$(git_common_of "$PWD")"
        branch="$(git -C "$PWD" branch --show-current 2>/dev/null || true)"; [ -n "$branch" ] || branch="(detached)"
        commit="$(git -C "$PWD" rev-parse --short HEAD 2>/dev/null || echo unknown)"
        if [ -n "$(git -C "$PWD" status --short 2>/dev/null || true)" ]; then dirty="dirty"; else dirty="clean"; fi
    else
        repo="(none)"; common="(none)"; branch="(none)"; commit="(none)"; dirty="(none)"
    fi
    local thread="${CODEX_THREAD_ID:-(unset)}" created; created="$(now_utc)"
    safe_value "repository path" "$repo"; safe_value "git common dir" "$common"
    safe_value "branch name" "$branch"; safe_value "commit" "$commit"; safe_value "dirty state" "$dirty"
    safe_value "CODEX_THREAD_ID" "$thread"

    ensure_store
    local base id n=1
    base="$(date -u +%Y-%m-%dT%H%M%SZ)-$slug"; id="$base"
    while :; do
        if [ -e "$ARCH/$id" ] || tombstoned "$id" || ! mkdir "$EXCH/$id" 2>/dev/null; then
            n=$((n+1)); id="$base-$n"; [ "$n" -le 1000 ] || die "could not reserve an exchange id"; continue
        fi
        break
    done
    local dir="$EXCH/$id"
    # Stage in a private dot-dir and rename onto the reserved (empty) directory: a crash
    # mid-creation leaves only invisible litter (GC'd by prune --apply after a day),
    # never a half-built exchange for status/list to defend against.
    local stage="$EXCH/.new.$$"
    rm -rf -- "$stage" 2>/dev/null || true
    mkdir "$stage" || { rmdir "$dir" 2>/dev/null; die "cannot create a staging directory in $EXCH"; }

    cat > "$stage/prompt.md" <<EOF
Exchange-ID: $id
Requester: $requester
Target: $target
Repo: $repo
Git-Common-Dir: $common
Branch: $branch
Commit: $commit
Dirty-State: $dirty
Created-UTC: $created
Codex-Thread: $thread${parent:+
Parent-Exchange: $parent}

Task:
<!-- $TASK_PLACEHOLDER_MARK $target.
     When the prompt is final, run:  secondopinion publish $id  -->

Required reading:
- The target repository's AGENTS.md / CLAUDE.md (at Repo above) and the startup files they name.
- Any source files, artifacts, or plans cited by the task above.

Response requirements:
- Work in the exact checkout named by Repo above; verify Branch/Commit and report drift.
- Start the response with 'Exchange-ID: $id' and 'Responder: <name>' lines.
- Label conclusions PROVEN / LIKELY / UNPROVEN / REJECTED where applicable.
- Ground claims in current source, current artifacts, current git history, or cited docs.
- State a clear verdict and next action.
- Publish with:  secondopinion claim $id  then  secondopinion respond $id --token <claim_token> --file <response.md>
EOF
    chmod 600 "$stage/prompt.md"
    lock "$stage"
    meta_set "$stage" exchange_id "$id" state draft created_utc "$created" created_epoch "$(epoch)" \
        requester "$requester" target "$target" repo "$repo" git_common_dir "$common" \
        branch "$branch" commit "$commit" dirty_state "$dirty" codex_thread "$thread"
    [ -n "$parent" ] && meta_set "$stage" parent_exchange "$parent"
    unlock
    mv -T -- "$stage" "$dir" || { rm -rf -- "$stage" 2>/dev/null; rmdir "$dir" 2>/dev/null; die "could not finalize the exchange directory"; }
    echo "exchange_id=$id"
    echo "exchange_dir=$dir"
    echo "prompt_path=$dir/prompt.md"
    echo "state=draft"
    echo "next=edit prompt.md, then: secondopinion publish $id"
}

# ---- ask: the no-intervention path -------------------------------------------------------
# Mirrors the Codex plugin's shape from the other side: one command publishes the exchange and
# runs a headless Claude Code responder that never prompts (deny-instead-of-ask), in the exact
# checkout the request was made from, then returns the validated answer.
RESPONDER_LOG=""
respond_skill_file() { # -> path of the respond instructions shipped next to this CLI
    local self; self="$(readlink -f "${BASH_SOURCE[0]}")" || return 1
    printf '%s/skills/secondopinion-respond/SKILL.md\n' "${self%/bin/*}"
}

responder_prompt() { # id -> the self-contained headless prompt on stdout.
    # Everything the responder needs travels IN the prompt (the respond skill body,
    # frontmatter stripped, plus the assignment): nothing has to be installed in
    # Claude — only the `claude` CLI itself, mirroring the Claude->Codex plugin,
    # which installs nothing in Codex.
    local skill; skill="$(respond_skill_file)" || return 1
    [ -f "$skill" ] && [ -r "$skill" ] || return 1
    awk 'NR==1 && /^---[[:space:]]*$/ {infm=1; next}
         infm {if (/^---[[:space:]]*$/) infm=0; next}
         {print}' "$skill" || return 1
    printf '\n%s\n\n%s\n' \
        "You are running headlessly: \`secondopinion ask\` started you to answer exactly one exchange. There is no user watching: never wait for input, follow the workflow above to the end, and treat the request as read-only unless its prompt says otherwise. Answer only the exchange named on the next line." \
        "Exchange-ID: $1"
}

claude_effort_levels() { # bin -> space-separated levels from the live CLI's --help, or ""
    "$1" --help 2>/dev/null | grep -A2 -- '--effort' | grep -oE '\(([a-z]+(, [a-z]+)*)\)' | head -1 | tr -d '(),' || true
    return 0
}

new_session_uuid() { python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null || uuidgen 2>/dev/null; }

build_responder_argv() { # arrayname id write_mode model effort session_mode session_arg max_turns
    # session_mode: "" (private: --no-session-persistence) | persist (--session-id ARG)
    #             | resume (--resume ARG, session stays persisted)
    local -n _argv="$1"
    local bin="${SECONDOPINION_CLAUDE:-claude}" prompt
    prompt="$(responder_prompt "$2")" || return 1
    _argv=("$bin" -p "$prompt" --max-turns "${8:-${SECONDOPINION_MAX_TURNS:-60}}" --output-format json)
    case "${6:-}" in
        persist) _argv+=(--session-id "$7");;
        resume)  _argv+=(--resume "$7");;
        *)       _argv+=(--no-session-persistence);;
    esac
    if [ "$3" = 1 ]; then
        _argv+=(--permission-mode acceptEdits --allowedTools Bash)
    else
        _argv+=(--permission-mode dontAsk --allowedTools "Bash,Read,Grep,Glob,Write" \
            --disallowedTools "Edit,NotebookEdit,WebFetch,WebSearch")
    fi
    [ -n "$4" ] && _argv+=(--model "$4")
    [ -n "${5:-}" ] && _argv+=(--effort "$5")
    return 0
}
cmd_ask() {
    local topic="" file="" task="" timeout="${SECONDOPINION_ASK_TIMEOUT:-1800}" write=0 background=0 model="" json=""
    local effort="" persist=0 followup="" resume="" fresh=0 review_mode="${ASK_REVIEW_MODE:-}" maxturns="" attach=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --topic) [ "$#" -ge 2 ] || die "--topic requires a value"; topic="$2"; shift 2;;
            --file) [ "$#" -ge 2 ] || die "--file requires a value"; file="$2"; shift 2;;
            --task) [ "$#" -ge 2 ] || die "--task requires a value"; task="$2"; shift 2;;
            --timeout) [ "$#" -ge 2 ] || die "--timeout requires seconds"; timeout="$2"; shift 2;;
            --model) [ "$#" -ge 2 ] || die "--model requires a value"; model="$2"; shift 2;;
            --effort) [ "$#" -ge 2 ] || die "--effort requires a level"; effort="$2"; shift 2;;
            --max-turns) [ "$#" -ge 2 ] || die "--max-turns requires a count"; maxturns="$2"; shift 2;;
            --attach) [ "$#" -ge 2 ] || die "--attach requires an exchange ID"; attach="$2"; shift 2;;
            --follow-up) [ "$#" -ge 2 ] || die "--follow-up requires a parent exchange ID"; followup="$2"; shift 2;;
            --resume) [ "$#" -ge 2 ] || die "--resume requires a parent exchange ID"; resume="$2"; shift 2;;
            --persist) persist=1; shift;;
            --fresh) fresh=1; shift;;
            --write) write=1; shift;;
            --background) background=1; shift;;
            --json) json=1; shift;;
            -h|--help) usage; exit 0;;
            *) die "unknown ask option: $1";;
        esac
    done
    if [ -n "$attach" ]; then
        require_id "$attach"
        { [ -z "$topic$file$task$followup$resume" ] && [ "$persist" = 0 ]; } \
            || die "--attach re-launches a responder for an EXISTING published exchange; it cannot be combined with --topic/--file/--task/--follow-up/--resume/--persist"
    else
        [ -n "$topic" ] || die "ask requires --topic TOPIC"
        { [ -n "$file" ] && [ -z "$task" ]; } || { [ -z "$file" ] && [ -n "$task" ]; } || die "ask requires exactly one of --file REQ.md (or --file -) or --task TEXT"
    fi
    timeout="$(parse_secs "--timeout" "$timeout")" || exit 1
    [ "$timeout" -gt 0 ] || die "ask --timeout must be at least 1 second (GNU timeout treats 0 as 'no limit'); no exchange was created"
    [ -z "$model" ] || safe_value "--model" "$model"
    [ -z "$maxturns" ] || { maxturns="$(parse_count "--max-turns" "$maxturns")" || exit 1; }
    local bin="${SECONDOPINION_CLAUDE:-claude}"
    command -v -- "$bin" >/dev/null 2>&1 || die "responder binary '$bin' not found (install the 'claude' CLI so it is on PATH, or set SECONDOPINION_CLAUDE); no exchange was created"
    local skill_file; skill_file="$(respond_skill_file)" || die "cannot resolve this CLI's own path; no exchange was created"
    { [ -f "$skill_file" ] && [ -r "$skill_file" ]; } || die "respond instructions missing or unreadable: $skill_file — the CLI must run from (or be symlinked into) its checkout; re-run plugins/secondopinion/scripts/install.sh. No exchange was created"
    if [ -n "$effort" ]; then
        safe_value "--effort" "$effort"
        local levels; levels="$(claude_effort_levels "$bin")"
        [ -n "$levels" ] || die "the responder CLI '$bin' does not support --effort; no exchange was created"
        case " $levels " in *" $effort "*) ;; *) die "invalid --effort '$effort' (this claude CLI supports: ${levels// /, }); no exchange was created";; esac
    fi
    [ -n "$followup" ] && [ -n "$resume" ] && die "use either --follow-up or --resume, not both"
    [ "$fresh" = 1 ] && [ -n "$resume" ] && die "--fresh and --resume are mutually exclusive (--fresh is the default)"
    # Parent validation happens BEFORE anything is created: the parent must be answered (or
    # archived), hash-valid, and belong to THIS repository. Its text is captured as a
    # validated snapshot (what is embedded is exactly what was hashed).
    local parent="" parent_prompt_txt="" parent_resp_txt="" resume_sid=""
    parent="${followup:-$resume}"
    if [ -n "$parent" ]; then
        require_id "$parent"
        local pdir pstate pcommon curcommon
        pdir="$(exdir "$parent")"
        pstate="$(meta_get "$pdir" state)"
        case "$pstate" in answered|archived) ;; *) die "parent exchange $parent is not answered (state=$pstate); nothing to follow up on. No exchange was created";; esac
        pcommon="$(meta_get "$pdir" git_common_dir)"
        curcommon="$(git_common_of "$PWD")"; [ -n "$curcommon" ] || curcommon="(none)"
        [ "$pcommon" = "$curcommon" ] || die "parent exchange $parent belongs to another repository ($pcommon); run the follow-up from that checkout. No exchange was created"
        [ "$(prompt_ok "$pdir")" = "yes" ] || die "parent prompt failed validation; refusing to build on it. No exchange was created"
        [ "$(response_ok "$pdir")" = "yes" ] || die "parent response failed validation (hash or Exchange-ID mismatch); refusing to build on it. No exchange was created"
        parent_prompt_txt="$(emit_validated "$pdir" prompt.md prompt_sha256)" || die "parent prompt snapshot failed validation. No exchange was created"
        parent_resp_txt="$(emit_validated "$pdir" response.md response_sha256)" || die "parent response snapshot failed validation. No exchange was created"
        if [ -n "$resume" ]; then
            resume_sid="$(meta_get "$pdir" session_id)"
            [ -n "$resume_sid" ] || die "parent exchange $parent has no persisted session (it was not asked with --persist); use --follow-up instead. No exchange was created"
            printf '%s' "$resume_sid" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' \
                || die "stored session id for $parent is malformed; refusing to pass it to the responder. Use --follow-up instead"
        fi
    fi
    local session_mode="" session_arg=""
    if [ -n "$resume" ]; then session_mode="resume"; session_arg="$resume_sid"
    elif [ "$persist" = 1 ]; then
        session_mode="persist"; session_arg="$(new_session_uuid)"
        printf '%s' "$session_arg" | grep -Eq '^[0-9a-f-]{36}$' || die "could not generate a session id (python3 or uuidgen required for --persist)"
    fi
    local id dir
    if [ -n "$attach" ]; then
        [ -L "$EXCH/$attach" ] && die "refusing symlinked exchange directory: $attach"
        is_active "$attach" || { is_archived "$attach" && die "exchange $attach is archived: secondopinion result $attach"; die "unknown exchange: $attach"; }
        dir="$EXCH/$attach"; check_components "$dir"
        local astate; astate="$(meta_get "$dir" state)"
        case "$astate" in
            published) ;;
            claimed)  die "exchange $attach is claimed by '$(meta_get "$dir" claimed_by)'; a second responder cannot attach — wait for it, or after SECONDOPINION_STALE_CLAIM_SECS a responder may claim $attach --takeover";;
            answered|archived) die "exchange $attach is already $astate: secondopinion result $attach";;
            *) die "exchange $attach is not published (state=$astate); publish it first";;
        esac
        [ "$(prompt_ok "$dir")" = "yes" ] || die "exchange $attach prompt failed validation; refusing to attach a responder"
        [ "$(responder_state "$dir")" = "running" ] && die "a responder for $attach is still running (pid $(meta_get "$dir" responder_pid)); attaching now would truncate its log and orphan it — cancel it first: secondopinion cancel $attach"
        [ "$write" = 1 ] && [ -n "$(meta_get "$dir" review_mode)" ] && die "exchange $attach is a review exchange and reviews are read-only; --write is not allowed when attaching"
        [ -n "${SECONDOPINION_TEST_ATTACH_PAUSE:-}" ] && sleep "$SECONDOPINION_TEST_ATTACH_PAUSE"
        id="$attach"
    fi
    # Read the request text before creating anything.
    local request=""
    if [ -n "$attach" ]; then :
    elif [ -n "$task" ]; then request="$task"
    elif [ "$file" = "-" ]; then request="$(cat)"
    else regular "$file" || die "request file missing or not a regular file: $file"; request="$(cat -- "$file")"; fi
    [ -n "$attach" ] || [ -n "$(trim "$request")" ] || die "the request text is empty"
    if [ -n "$parent" ]; then
        request="$request

---
Context: this exchange is a follow-up to exchange $parent. The validated parent
prompt and response are below; do not re-answer them, build on them.
--- parent prompt (validated snapshot) ---
$parent_prompt_txt
--- parent response (validated snapshot) ---
$parent_resp_txt
--- end of parent context ---"
    fi
    # Create + fill + publish (skipped for --attach: the exchange already exists).
    local created prompt
    if [ -z "$attach" ]; then
    local new_args=(--topic "$topic"); [ -n "$parent" ] && new_args+=(--parent "$parent")
    created="$(cmd_new "${new_args[@]}")" || exit 1
    id="$(printf '%s\n' "$created" | awk -F= '$1=="exchange_id"{print $2; exit}')"
    dir="$(active_dir "$id")"; prompt="$dir/prompt.md"
    # Replace the placeholder block with the request (kept as a private temp, then moved).
    local tmp; tmp="$(mktemp "$dir/.prompt.tmp.XXXXXX")"
    awk -v req="$request" '
        BEGIN{skip=0}
        /^<!-- Replace this section with the focused request for /{skip=1; print req; next}
        skip==1 { if ($0 ~ /-->$/) {skip=0}; next }
        {print}' "$prompt" > "$tmp" && mv -f -- "$tmp" "$prompt"
    chmod 600 "$prompt"
    cmd_publish "$id" >/dev/null || exit 1
    fi
    # Responder in the checkout the exchange records (or the cwd for non-git requests).
    local repo; repo="$(meta_get "$dir" repo)"; [ -d "$repo" ] || repo="$PWD"
    mkdir -p "$STORE/responder-logs"; chmod 700 "$STORE/responder-logs"
    RESPONDER_LOG="$STORE/responder-logs/$id.log"
    local argv=(); build_responder_argv argv "$id" "$write" "$model" "$effort" "$session_mode" "$session_arg" "$maxturns" || die "could not build the responder command (respond instructions unreadable)"
    if [ -n "${SECONDOPINION_CLAUDE_ARGS:-}" ]; then
        # Word-split deliberately, but via read -a so glob characters are never expanded
        # against the responder's cwd.
        local extra=(); read -r -a extra <<<"${SECONDOPINION_CLAUDE_ARGS}"; argv+=("${extra[@]}")
    fi
    lock "$dir"
    if [ -n "$attach" ]; then
        # Re-check under the lock: a claim can land between the unlocked validation above
        # and here; launching anyway would waste a whole responder session and overwrite
        # the winner's responder_mode/log records.
        local attach_state; attach_state="$(meta_get "$dir" state)"
        [ "$attach_state" = "published" ] || { unlock; die "exchange $attach is no longer published (state=$attach_state); another responder got there first"; }
    fi
    meta_set "$dir" responder_mode headless responder_log "$RESPONDER_LOG" ask_started_utc "$(now_utc)"
    [ -n "$model" ] && meta_set "$dir" requested_model "$model"
    [ -n "$effort" ] && meta_set "$dir" requested_effort "$effort"
    [ -n "$review_mode" ] && meta_set "$dir" review_mode "$review_mode"
    case "$session_mode" in
        persist) meta_set "$dir" session_id "$session_arg" session_persist yes;;
        resume)  meta_set "$dir" session_id "$session_arg" session_persist yes;;
    esac
    unlock
    if [ "$background" = 1 ]; then
        local sandbox_init
        if sandbox_init="$(in_ephemeral_sandbox)"; then
            echo "WARNING: this shell runs inside a PID-namespaced sandbox (init='$sandbox_init'). A --background responder is detached from the shell but CANNOT survive the sandbox: it will be KILLED when the launching command's sandbox is torn down. Keep this session alive until the exchange is answered, use a foreground ask, or re-launch later with: secondopinion ask --attach $id" >&2
            # Also on stdout as parseable keys: the caller is usually an agent that reads
            # stdout key=value output and may never surface a stderr warning to its user.
            echo "sandbox=pid-namespaced init='$sandbox_init'"
            echo "sandbox_note=a --background responder dies with this sandbox; keep this shell alive until answered, or re-launch later with: secondopinion ask --attach $id"
        fi
        # INVARIANT: $! is claude's OWN pid only because this background subshell is not a
        # process-group leader, so setsid(1) takes over IN PLACE (no fork). Putting job
        # control or a wrapper between `&` and exec makes the recorded pid+starttime
        # describe a dead intermediary and breaks responder_state and cancel's group kill.
        # If the launch shape ever changes, have the child record its own pid instead.
        ( cd -- "$repo" && exec setsid nohup "${argv[@]}" </dev/null >"$RESPONDER_LOG" 2>&1 ) &
        local bgpid=$! bgstart
        bgstart="$(proc_start "$bgpid")"
        lock "$dir"; meta_set "$dir" responder_pid "$bgpid" responder_starttime "${bgstart:-unknown}"; unlock
        # Startup handshake (up to 2s): a responder that dies immediately without claiming
        # or answering is a startup failure and must be reported as one, not as success.
        local hs="running" hi=0 hstate
        while [ "$hi" -lt 20 ]; do
            if [ -z "$bgstart" ] || [ "$(proc_start "$bgpid")" != "$bgstart" ]; then
                hstate="$(meta_get "$dir" state)"
                case "$hstate" in answered|claimed) hs="finished";; *) hs="dead";; esac
                break
            fi
            if [ -s "$RESPONDER_LOG" ] || [ "$(meta_get "$dir" state)" != "published" ]; then break; fi
            sleep 0.1; hi=$((hi+1))
        done
        echo "exchange_id=$id"; echo "state=$(meta_get "$dir" state)"
        if [ "$hs" = "dead" ]; then
            echo "responder=startup-failed"; echo "responder_pid=$bgpid"; echo "responder_log=$RESPONDER_LOG"
            echo "result=the responder exited within seconds without claiming or answering; inspect the log, then retry with: secondopinion ask --attach $id" >&2
            return 1
        fi
        echo "responder=background"; echo "responder_pid=$bgpid"; echo "responder_log=$RESPONDER_LOG"
        echo "next=secondopinion wait $id  &&  secondopinion read-response $id"
        return 0
    fi
    local rc=0
    # Foreground runs also record the responder's identity so status/jobs in OTHER
    # sessions show real liveness (and cancel can reach it) while this ask is in flight.
    ( cd -- "$repo" && exec timeout --kill-after=10 "$timeout" "${argv[@]}" </dev/null >"$RESPONDER_LOG" 2>&1 ) &
    local fgpid=$! fgstart; fgstart="$(proc_start "$fgpid")"
    lock "$dir"; meta_set "$dir" responder_pid "$fgpid" responder_starttime "${fgstart:-unknown}"; unlock
    wait "$fgpid" || rc=$?
    local state; state="$(meta_get "$dir" state)"
    if [ -n "$model" ] || [ -n "$effort" ]; then record_realized_model "$dir" "$RESPONDER_LOG"; fi
    if [ "$state" = "answered" ] && [ "$(response_ok "$dir")" = "yes" ] && [ "$(prompt_ok "$dir")" = "yes" ]; then
        if [ -n "$json" ]; then emit_status "$dir" json; echo; else cat "$dir/response.md"; fi
        return 0
    fi
    echo "exchange_id=$id" >&2; echo "state=$state" >&2; echo "responder_log=$RESPONDER_LOG" >&2
    local retry_hint="the exchange stays published and the launched responder is gone; retry with: secondopinion ask --attach $id  (or let any responder session answer it, then: secondopinion wait $id)"
    [ "$state" = "claimed" ] && retry_hint="state=claimed: the responder claimed the exchange before dying, and its claim token is lost; if it published its response first, secondopinion result $id recovers it; otherwise after SECONDOPINION_STALE_CLAIM_SECS (default 1800) another responder can run: secondopinion claim $id --takeover --owner ..."
    if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
        printf '[secondopinion] responder killed by ask --timeout after %ss at %s\n' "$timeout" "$(now_utc)" >> "$RESPONDER_LOG" 2>/dev/null || true
        echo "result=timeout after ${timeout}s; $retry_hint" >&2
        return 124
    fi
    die "responder exited $rc without a valid answer; see the log above; $retry_hint"
}

record_realized_model() { # dir log — record the model the responder PROVED using, else "unproven"
    local m=""
    if [ -f "$2" ] && [ ! -L "$2" ]; then
        m="$(python3 - "$2" 2>/dev/null <<'PYEOF'
import json, sys
best = ""
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        d = json.loads(line)
    except Exception:
        continue
    mu = d.get("modelUsage")
    if isinstance(mu, dict) and mu:
        best = sorted(mu.keys())[0]
print(best)
PYEOF
)" || m=""
    fi
    lock "$1"; meta_set "$1" realized_model "${m:-unproven}"; unlock
    return 0
}

REVIEW_CONTRACT='At the END of the response add a fenced ```json block with EXACTLY this shape (machine-parsed): {"verdict": "approve" | "needs-attention", "summary": "<one paragraph>", "findings": [{"severity": "critical|major|minor|info", "title": "...", "body": "...", "file": "<repo-relative path or empty>", "line_start": 0, "line_end": 0, "confidence": "high|medium|low", "recommendation": "..."}], "next_steps": ["..."]}. Keep the block valid JSON; the prose response above it remains the full answer.'

cmd_review() {
    # Dedicated review interface: composes a review charter + target scope + structured
    # output contract, then delegates to `ask`. Reviews are strictly read-only.
    local adversarial=0 base="" topic="" focus="" pass=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --adversarial) adversarial=1; shift;;
            --base) [ "$#" -ge 2 ] || die "--base requires a git ref"; base="$2"; shift 2;;
            --scope) [ "$#" -ge 2 ] || die "--scope requires working-tree"; [ "$2" = "working-tree" ] || die "unknown --scope '$2' (working-tree, or use --base REF)"; shift 2;;
            --topic) [ "$#" -ge 2 ] || die "--topic requires a value"; topic="$2"; shift 2;;
            --task) [ "$#" -ge 2 ] || die "--task requires a value"; focus="$2"; shift 2;;
            --write) die "reviews are read-only; --write is not available under 'review' (use plain 'ask --write' for a task that must edit)";;
            --timeout|--model|--effort|--max-turns|--follow-up|--resume) [ "$#" -ge 2 ] || die "$1 requires a value"; pass+=("$1" "$2"); shift 2;;
            --background|--json|--persist|--fresh) pass+=("$1"); shift;;
            -h|--help) echo "usage: review [--adversarial] [--base REF | --scope working-tree] [--task FOCUS] [--topic T] [ask options: --timeout --model --effort --background --json --persist --follow-up ID --resume ID]"; exit 0;;
            *) die "unknown review option: $1";;
        esac
    done
    git -C "$PWD" rev-parse --git-dir >/dev/null 2>&1 || die "review must run inside the git checkout to be reviewed"
    if [ -n "$base" ]; then
        safe_value "--base" "$base"
        git -C "$PWD" rev-parse --verify --quiet "$base^{commit}" >/dev/null || die "--base ref not found in this repository: $base (no exchange was created)"
    fi
    local charter target
    if [ "$adversarial" = 1 ]; then
        charter="Perform an ADVERSARIAL review: challenge the implementation approach, the design choices, the tradeoffs and the assumptions behind this change — not just its line-level defects. Actively try to refute that the chosen approach is right; name the strongest alternative and what evidence would decide between them."
        [ -n "$topic" ] || topic="adversarial review"
    else
        charter="Perform a focused code review: find real defects (correctness, concurrency, error handling, security, API misuse) with evidence. Judge what the change SHOULD do, not only what it does."
        [ -n "$topic" ] || topic="code review"
    fi
    if [ -n "$base" ]; then
        target="Target: the committed changes $base...HEAD — run: git diff $base...HEAD (with git log $base..HEAD for intent), plus any context files needed."
    else
        target="Target: the UNCOMMITTED working-tree changes of this checkout — run: git status --short; git diff; git diff --cached — plus any context files needed."
    fi
    local composed="$charter

$target

This review is READ-ONLY: you must not modify, fix, or format anything — report findings only.
${focus:+Focus requested by the asker: $focus
}
$REVIEW_CONTRACT"
    ASK_REVIEW_MODE="$([ "$adversarial" = 1 ] && echo adversarial || echo normal)"
    cmd_ask --topic "$topic" --task "$composed" "${pass[@]+"${pass[@]}"}"
}

cmd_review_result() {
    [ "$#" -eq 1 ] || die "usage: review-result ID"
    local id="$1"; require_id "$id"
    local raw; raw="$(cmd_read_response "$id")" || exit 1   # one validated snapshot; parsed below as-is
    local parsed rc=0 rtmp; rtmp="$(mktemp)"; printf '%s\n' "$raw" > "$rtmp"
    parsed="$(python3 - "$rtmp" 2>/dev/null <<'PYEOF'
import json, re, sys
raw = open(sys.argv[1], encoding="utf-8", errors="replace").read()
blocks = re.findall(r"```json\s*\n(.*?)(?:\n```|\Z)", raw, re.S)
ok = False
for cand in reversed(blocks):
    try:
        d = json.loads(cand)
    except Exception:
        continue
    if not isinstance(d, dict): continue
    if d.get("verdict") not in ("approve", "needs-attention"): continue
    if not isinstance(d.get("summary"), str) or not d["summary"].strip(): continue
    if not isinstance(d.get("findings"), list): continue
    if not isinstance(d.get("next_steps"), list): continue
    ok = True
    print("parse_ok=yes")
    print("verdict=" + d["verdict"])
    print("findings=%d" % len(d["findings"]))
    print("summary=" + " ".join(d["summary"].split())[:300])
    print("---")
    print(json.dumps(d, indent=2))
    break
if not ok:
    sys.exit(3)
PYEOF
)" || rc=$?
    rm -f -- "$rtmp"
    if [ "$rc" = 0 ]; then
        printf '%s\n' "$parsed"
        return 0
    fi
    # Honest fallback: no schema-valid block — say so and hand over the full raw response.
    echo "parse_ok=no"
    echo "note=no schema-valid fenced json review block found; the full raw response follows"
    echo "---"
    printf '%s\n' "$raw"
    return 3
}

cmd_publish() {
    [ "$#" -eq 1 ] || die "usage: publish ID"
    local dir; dir="$(active_dir "$1")"
    lock "$dir"
    local state; state="$(meta_get "$dir" state)"
    case "$state" in
        published|claimed|answered)
            [ "$(prompt_ok "$dir")" = "yes" ] || { unlock; die "published prompt.md failed hash/header validation (state=$state); create a new exchange"; }
            unlock; echo "exchange_id=$1"; echo "state=$state"; echo "prompt_sha256=$(meta_get "$dir" prompt_sha256)"; echo "note=already published"; return 0;;
        draft) ;;
        *) unlock; die "cannot publish from state '$state'";;
    esac
    regular "$dir/prompt.md" || { unlock; die "prompt.md missing or not a regular file"; }
    local hreason; hreason="$(header_check "$dir/prompt.md")"; [ -z "$hreason" ] || { unlock; die "prompt.md $hreason"; }
    [ "$(head -n1 "$dir/prompt.md" | tr -d '\r')" = "Exchange-ID: $1" ] || { unlock; die "prompt.md must start with 'Exchange-ID: $1'"; }
    grep -q "^[[:space:]]*<!-- $TASK_PLACEHOLDER_MARK " "$dir/prompt.md" && { unlock; die "prompt.md still contains the Task placeholder; edit the Task section before publish"; }
    local h; h="$(sha "$dir/prompt.md")"
    chmod 400 "$dir/prompt.md"
    meta_set "$dir" state published prompt_sha256 "$h" published_utc "$(now_utc)"
    unlock
    echo "exchange_id=$1"; echo "state=published"; echo "prompt_sha256=$h"
}

emit_status() { # dir [json]
    local dir="$1" json="${2:-}" k v
    [ -f "$dir/meta" ] && [ ! -L "$dir/meta" ] || die "exchange has no meta (interrupted 'new'?); nothing to report — remove the directory to clean up: $dir"
    local pok rok cage="" cep state
    pok="$(prompt_ok "$dir")"; rok="$(response_ok "$dir")"; state="$(meta_get "$dir" state)"
    cep="$(meta_get "$dir" claimed_epoch)"
    if [ "$state" = "claimed" ] && [ -n "$cep" ]; then cage="$(( $(epoch) - cep ))"; fi
    if [ -n "$json" ]; then
        printf '{'
        local first=1
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            k="${line%%=*}"; v="${line#*=}"
            [ "$first" = 1 ] || printf ','; first=0
            printf '%s:%s' "$(json_str "$k")" "$(json_str "$v")"
        done < "$dir/meta"
        printf ',"exchange_dir":%s,"prompt_ok":%s,"response_ok":%s,"response_present":%s' \
            "$(json_str "$dir")" "$(json_str "$pok")" "$(json_str "$rok")" "$( [ -e "$dir/response.md" ] && echo '"yes"' || echo '"no"')"
        [ -n "$cage" ] && printf ',"claim_age_secs":%s' "$cage"
        local ce rstate; ce="$(meta_get "$dir" created_epoch)"; rstate="$(responder_state "$dir")"
        [ -n "$ce" ] && printf ',"elapsed_secs":%s' "$(json_str "$(( $(epoch) - ce ))")"
        [ -n "$rstate" ] && printf ',"responder_status":%s' "$(json_str "$rstate")"
        printf '}'
    else
        cat "$dir/meta"
        echo "exchange_dir=$dir"
        echo "prompt_ok=$pok"
        echo "response_present=$( [ -e "$dir/response.md" ] && echo yes || echo no)"
        echo "response_ok=$rok"
        [ -n "$cage" ] && echo "claim_age_secs=$cage"
        status_extras "$dir" "$state"
    fi
    return 0
}

status_extras() { # dir state -> elapsed, responder liveness, and a next-action hint
    local dir="$1" state="$2" ce rstate id
    ce="$(meta_get "$dir" created_epoch)"
    [ -n "$ce" ] && echo "elapsed_secs=$(( $(epoch) - ce ))"
    rstate="$(responder_state "$dir")"
    [ -n "$rstate" ] && echo "responder_status=$rstate"
    id="$(meta_get "$dir" exchange_id)"
    case "$state" in
        draft)     echo "next=edit the Task section of prompt.md, then: secondopinion publish $id";;
        published) if [ "$rstate" = "running" ]; then echo "next=responder running: secondopinion wait $id  (or: secondopinion cancel $id)"
                   elif [ "$rstate" = "exited" ] || [ "$rstate" = "cancelled" ]; then echo "next=responder $rstate without answering; inspect $(meta_get "$dir" responder_log); retry with: secondopinion ask --attach $id  (or any responder session, then: secondopinion wait $id)"
                   else echo "next=waiting for a responder: secondopinion wait $id"; fi;;
        claimed)   echo "next=claimed by $(meta_get "$dir" claimed_by); if stale (>SECONDOPINION_STALE_CLAIM_SECS), another responder may run: secondopinion claim $id --takeover --owner ...";;
        answered)  echo "next=secondopinion result $id   then: secondopinion archive $id";;
        archived)  echo "next=archived (read: secondopinion result $id)";;
    esac
    return 0
}

cmd_status() {
    local id="" json=""
    while [ "$#" -gt 0 ]; do case "$1" in --json) json=1;; -h|--help) usage; exit 0;; *) positional id "$1";; esac; shift; done
    [ -n "$id" ] || die "usage: status ID [--json]"
    local dir; dir="$(exdir "$id")"
    emit_status "$dir" "$json"; [ -n "$json" ] && echo
    return 0
}

cmd_path() { [ "$#" -eq 1 ] || die "usage: path ID"; exdir "$1"; }

cmd_show() {
    [ "$#" -eq 1 ] || die "usage: show ID"
    local dir; dir="$(exdir "$1")"
    regular "$dir/prompt.md" || die "prompt.md missing or not a regular file"
    cat "$dir/prompt.md"
}

cmd_list() {
    local filter="active" repo_filter="" json="" want_common=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --pending) filter="pending";; --answered) filter="answered";; --drafts) filter="drafts";; --all) filter="all";;
            --repo) [ "$#" -ge 2 ] || die "--repo requires a path"; repo_filter="$2"; shift;;
            --here) repo_filter="$PWD";;
            --json) json=1;;
            -h|--help) usage; exit 0;;
            *) die "unknown list option: $1";;
        esac; shift
    done
    if [ -n "$repo_filter" ]; then
        [ -d "$repo_filter" ] || die "--repo path not found: $repo_filter"
        want_common="$(git_common_of "$repo_filter")"
        [ -n "$want_common" ] || die "--repo path is not inside a git repository: $repo_filter"
    fi
    local dirs=() d
    if [ -d "$EXCH" ]; then for d in "$EXCH"/*/; do real_dir "${d%/}" && dirs+=("${d%/}"); done; fi
    if [ "$filter" = "all" ] && [ -d "$ARCH" ]; then for d in "$ARCH"/*/; do real_dir "${d%/}" && dirs+=("${d%/}"); done; fi
    local first=1 now; now="$(epoch)"
    [ -n "$json" ] && printf '['
    for d in "${dirs[@]}"; do
        [ -f "$d/meta" ] && [ ! -L "$d/meta" ] || continue
        local id state common
        id="$(meta_get "$d" exchange_id)"; state="$(meta_get "$d" state)"; common="$(meta_get "$d" git_common_dir)"
        valid_id "$id" || continue
        case "$filter" in
            pending)  case "$state" in published|claimed) ;; *) continue;; esac; [ "$(prompt_ok "$d")" = "yes" ] || continue;;
            answered) [ "$state" = "answered" ] || continue;;
            drafts)   [ "$state" = "draft" ] || continue;;
            active|all) ;;
        esac
        if [ -n "$want_common" ]; then [ "$common" = "$want_common" ] || continue; fi
        local age ce; ce="$(meta_get "$d" created_epoch)"
        if [ -n "$ce" ]; then age="$(human_age $(( now - ce )))"; else age="-"; fi
        if [ -n "$json" ]; then
            [ "$first" = 1 ] || printf ','; first=0
            emit_status "$d" json
        else
            printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$state" "$age" "$(meta_get "$d" repo)" "$(meta_get "$d" target)"
        fi
    done
    [ -n "$json" ] && printf ']\n'
    return 0
}

cmd_claim() {
    local id="" owner="${SECONDOPINION_OWNER:-${USER:-user}@$(hostname)}" takeover=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --owner) [ "$#" -ge 2 ] || die "--owner requires a value"; owner="$2"; shift;;
            --takeover) takeover=1;;
            -h|--help) usage; exit 0;;
            *) positional id "$1";;
        esac; shift
    done
    [ -n "$id" ] || die "usage: claim ID [--owner NAME] [--takeover]"
    safe_value "--owner" "$owner"; owner="$(trim "$owner")"; [ -n "$owner" ] || die "--owner must not be empty"
    local dir; dir="$(active_dir "$id")"
    lock "$dir"
    local state; state="$(meta_get "$dir" state)"
    case "$state" in
        published)
            # An orphan claim/ (crash after mkdir, before meta) must not block a fresh claim.
            if [ -e "$dir/claim" ] || [ -L "$dir/claim" ]; then
                [ -L "$dir/claim" ] && { unlock; die "refusing symlinked claim in $id"; }
                rm -rf "$dir/claim"
            fi;;
        claimed)
            local cep age by; cep="$(meta_get "$dir" claimed_epoch)"; by="$(meta_get "$dir" claimed_by)"
            if [ ! -e "$dir/claim" ] && [ ! -L "$dir/claim" ]; then
                # state=claimed with no claim/: a takeover crashed between removing the old
                # claim and recording the new one. The token is gone, so nothing can ever
                # respond; treat the claim as orphaned and re-claim immediately.
                meta_set "$dir" previous_claimant "$by"
            else
                # An empty claimed_epoch (corrupt meta) counts as age 0: fail safe by
                # refusing takeover rather than treating the claim as infinitely stale.
                age=$(( $(epoch) - ${cep:-$(epoch)} ))
                if [ "$takeover" = 1 ] && [ "$age" -ge "$STALE_CLAIM_SECS" ]; then
                    [ -L "$dir/claim" ] && { unlock; die "refusing symlinked claim in $id"; }
                    meta_set "$dir" previous_claimant "$by"
                    rm -rf "$dir/claim"
                else
                    unlock; die "already claimed by '$by' (${age}s ago); --takeover is allowed after ${STALE_CLAIM_SECS}s"
                fi
            fi;;
        draft) unlock; die "exchange is not published yet";;
        *) unlock; die "cannot claim from state '$state'";;
    esac
    [ "$(prompt_ok "$dir")" = "yes" ] || { unlock; die "published prompt.md failed hash/header validation; refusing to claim"; }
    mkdir "$dir/claim" 2>/dev/null || { unlock; die "claim race lost; retry"; }
    local token; token="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
    if ! { printf '%s\n' "$token" > "$dir/claim/token" && printf '%s\n' "$owner" > "$dir/claim/owner" \
           && chmod 600 "$dir/claim/token" "$dir/claim/owner" \
           && meta_set "$dir" state claimed claimed_by "$owner" claimed_utc "$(now_utc)" claimed_epoch "$(epoch)"; }; then
        rm -rf "$dir/claim"; unlock; die "claim could not be recorded (I/O failure); nothing was claimed"
    fi
    unlock
    echo "exchange_id=$id"; echo "state=claimed"; echo "claimed_by=$owner"; echo "claim_token=$token"
    echo "repo=$(meta_get "$dir" repo)"
}

# Validate a candidate response file (already snapshotted): first line, Responder header.
# The Responder value is extracted once, trimmed, and must be nonempty and free of
# newlines/control bytes because it is stored in meta and echoed in JSON.
responder_of() { header_block "$1" | sed -nE '/^Responder: /{s/^Responder: //; s/^[[:space:]]+//; s/[[:space:]]+$//; p; q}'; }
validate_response_file() { # file id
    local hreason; hreason="$(header_check "$1")"; [ -z "$hreason" ] || die "response $hreason"
    [ "$(head -n1 "$1" | tr -d '\r')" = "Exchange-ID: $2" ] || die "response must start with 'Exchange-ID: $2'"
    header_block "$1" | grep -q '^Responder: ' || die "response must contain a 'Responder: <name>' line in its header block (before the first blank line)"
    local who; who="$(responder_of "$1")"
    safe_value "Responder" "$who"
    [ -n "$who" ] || die "response 'Responder:' value must not be empty"
    return 0
}
finalize_response() { # dir  (caller holds lock; response.md exists and validated)
    meta_set "$1" state answered answered_utc "$(now_utc)" response_sha256 "$(sha "$1/response.md")" responder "$(responder_of "$1/response.md")"
}

try_rollforward() { # dir id — finalize a valid response.md left by a responder that died
    # between ln and finalize (its claim token is lost). Write-once + validation make this
    # safe; without it the exchange stays claimed until a stale takeover re-runs respond.
    local dir="$1" id="$2"
    lock "$dir"
    if [ "$(meta_get "$dir" state)" = "claimed" ] && regular "$dir/response.md" \
       && [ "$(prompt_ok "$dir")" = "yes" ] \
       && ( validate_response_file "$dir/response.md" "$id" ) >/dev/null 2>&1; then
        finalize_response "$dir"; unlock; return 0
    fi
    unlock; return 1
}

cmd_respond() {
    local id="" token="" file=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --token) [ "$#" -ge 2 ] || die "--token requires a value"; token="$2"; shift;;
            --file) [ "$#" -ge 2 ] || die "--file requires a value"; file="$2"; shift;;
            -h|--help) usage; exit 0;;
            *) positional id "$1";;
        esac; shift
    done
    [ -n "$id" ] && [ -n "$token" ] && [ -n "$file" ] || die "usage: respond ID --token TOKEN --file FILE"
    local dir; dir="$(active_dir "$id")"
    # Snapshot the candidate FIRST (private temp inside the exchange), then validate the
    # snapshot, then link that exact snapshot: the caller's file can change afterwards
    # without affecting what is published.
    RESP_TMP="$(mktemp "$dir/.response.tmp.XXXXXX")" || die "cannot create temp file in $dir"
    trap '[ -n "${RESP_TMP:-}" ] && rm -f "$RESP_TMP"' EXIT
    local tmp="$RESP_TMP"
    if [ "$file" = "-" ]; then
        cat > "$tmp"
    else
        regular "$file" || die "response file missing or not a regular file: $file"
        cat -- "$file" > "$tmp"
    fi
    chmod 600 "$tmp"
    lock "$dir"
    local state; state="$(meta_get "$dir" state)"
    [ "$state" = "claimed" ] || { unlock; die "exchange is not claimed (state=$state); run: secondopinion claim $id"; }
    [ -f "$dir/claim/token" ] && [ ! -L "$dir/claim/token" ] && [ "$(cat "$dir/claim/token")" = "$token" ] || { unlock; die "claim token does not match"; }
    [ "$(prompt_ok "$dir")" = "yes" ] || { unlock; die "published prompt.md failed hash/header validation; refusing to respond"; }
    if [ -e "$dir/response.md" ] || [ -L "$dir/response.md" ]; then
        # A response already exists while state=claimed: a previous respond linked it but did
        # not finalize meta (interrupted). Roll forward if it validates; never overwrite it.
        [ -L "$dir/response.md" ] && { unlock; die "refusing symlinked response.md"; }
        if regular "$dir/response.md" && ( validate_response_file "$dir/response.md" "$id" ) >/dev/null 2>&1; then
            finalize_response "$dir"; unlock
            echo "exchange_id=$id"; echo "state=answered"; echo "response_path=$dir/response.md"; echo "note=recovered existing response (write-once); the new file was ignored"
            return 0
        fi
        unlock; die "response.md already exists but is not a valid response for $id (write-once; manual inspection needed)"
    fi
    validate_response_file "$tmp" "$id" || { unlock; exit 1; }
    if ! ln "$tmp" "$dir/response.md" 2>/dev/null; then
        if [ -e "$dir/response.md" ] || [ -L "$dir/response.md" ]; then unlock; die "response.md already exists (write-once)"; fi
        unlock; die "could not hardlink response.md into place (a filesystem without hardlink support? the store requires one POSIX filesystem)"
    fi
    if ! finalize_response "$dir"; then
        unlock; die "response.md was published but meta could not be updated; re-run the same respond to roll forward"
    fi
    unlock
    echo "exchange_id=$id"; echo "state=answered"; echo "response_path=$dir/response.md"
}

emit_validated() { # dir file meta-sha-key -> print a snapshot that MATCHES the recorded hash
    # Snapshot first, hash the snapshot, print the snapshot: what is validated is exactly
    # what is emitted (no validate-then-reread window).
    local dir="$1" f="$2" key="$3" want tmp
    want="$(meta_get "$dir" "$key")"; [ -n "$want" ] || return 1
    regular "$dir/$f" || return 1
    tmp="$(mktemp)" || return 1
    if ! cp -- "$dir/$f" "$tmp" || [ "$(sha "$tmp")" != "$want" ]; then rm -f -- "$tmp"; return 1; fi
    cat -- "$tmp"; rm -f -- "$tmp"
    return 0
}

cmd_read_response() {
    [ "$#" -eq 1 ] || die "usage: read-response ID"
    local dir; dir="$(exdir "$1")"
    local state; state="$(meta_get "$dir" state)"
    case "$state" in answered|archived) ;; *) die "no response yet (state=$state)";; esac
    [ "$(prompt_ok "$dir")" = "yes" ] || die "prompt.md does not match its published hash; response is not trustworthy"
    [ "$(response_ok "$dir")" = "yes" ] || die "response.md failed validation (hash or Exchange-ID mismatch)"
    emit_validated "$dir" response.md response_sha256 || die "response.md failed validation (hash or Exchange-ID mismatch)"
}

cmd_wait() {
    local id="" timeout="$DEFAULT_WAIT_TIMEOUT"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --timeout) [ "$#" -ge 2 ] || die "--timeout requires seconds"; timeout="$2"; shift;;
            -h|--help) echo "usage: wait ID [--timeout S]   (default timeout ${DEFAULT_WAIT_TIMEOUT}s; exit 0 answered, 124 timeout, 2 archived, 1 error)"; exit 0;;
            *) positional id "$1";;
        esac; shift
    done
    [ -n "$id" ] || die "usage: wait ID [--timeout S]"
    timeout="$(parse_secs "--timeout" "$timeout")" || exit 1
    require_id "$id"
    local deadline=$(( $(epoch) + timeout )) dir state
    while :; do
        [ -L "$EXCH/$id" ] || [ -L "$ARCH/$id" ] && die "refusing symlinked exchange directory: $id"
        if is_archived "$id"; then echo "exchange_id=$id"; echo "state=archived"; return 2; fi
        is_active "$id" || die "unknown exchange: $id"
        dir="$EXCH/$id"; check_components "$dir"; state="$(meta_get "$dir" state)"
        if [ "$state" = "archived" ]; then echo "exchange_id=$id"; echo "state=archived"; return 2; fi
        if [ "$state" = "claimed" ] && [ -e "$dir/response.md" ] && [ ! -L "$dir/response.md" ]; then
            if try_rollforward "$dir" "$id"; then state="$(meta_get "$dir" state)"; fi
        fi
        if [ "$state" = "answered" ]; then
            if [ "$(response_ok "$dir")" = "yes" ] && [ "$(prompt_ok "$dir")" = "yes" ]; then
                echo "exchange_id=$id"; echo "state=answered"; echo "response_path=$dir/response.md"
                echo "next=secondopinion read-response $id"; return 0
            fi
            die "exchange answered but response failed validation; run: secondopinion status $id"
        fi
        local now; now="$(epoch)"
        if [ "$now" -ge "$deadline" ]; then echo "exchange_id=$id"; echo "state=$state"; echo "result=timeout"; return 124; fi
        local remain=$(( deadline - now )); local nap=$POLL_SECS; [ "$remain" -lt "$nap" ] && nap="$remain"
        sleep "$nap"
    done
}

in_ephemeral_sandbox() { # prints /proc/1/comm and succeeds when PID 1 is not a real init
    local c; c="${SECONDOPINION_TEST_PID1_COMM:-$(cat /proc/1/comm 2>/dev/null)}"
    case "$c" in systemd|init) return 1;; "") return 1;; *) printf '%s\n' "$c"; return 0;; esac
}

proc_start() { # pid -> kernel start time in clock ticks, or "" if no such process
    local st; st="$(cat "/proc/$1/stat" 2>/dev/null)" || { echo ""; return 0; }
    st="${st##*) }"; # strip "pid (comm) " — comm may contain spaces/parens
    # shellcheck disable=SC2086
    set -- $st; printf '%s\n' "${20:-}"
}

responder_state() { # dir -> running|cancelled|exited|"" (no background responder recorded)
    local pid st0 cur
    pid="$(meta_get "$1" responder_pid)"; [ -n "$pid" ] || { echo ""; return 0; }
    st0="$(meta_get "$1" responder_starttime)"
    cur="$(proc_start "$pid")"
    if [ -n "$cur" ] && [ "$cur" = "$st0" ]; then echo "running"
    elif [ -n "$(meta_get "$1" responder_cancelled_utc)" ]; then echo "cancelled"
    else echo "exited"; fi
}

US=$'\x1f'   # field separator for prune bookkeeping; control bytes cannot appear in meta values

cmd_prune() {
    # Bounded retention over the ARCHIVE only. Buckets are per canonical git common dir
    # (plus one "(non-git)" bucket) so one busy repository cannot evict another's history.
    # Dry-run by default; --apply removes. Drafts, published, claimed and answered
    # exchanges all live under exchanges/ and are never candidates. Pruned IDs go to the
    # tombstones file first (append -> remove), so an ID is never reused even after a crash
    # between the two steps, and an interrupted apply completes on the next run.
    local apply=0 retain="${SECONDOPINION_RETAIN:-50}"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --apply) apply=1;;
            --retain) [ "$#" -ge 2 ] || die "--retain requires a count"; retain="$2"; shift;;
            -h|--help) echo "usage: prune [--apply] [--retain N]   (default: dry run, keep newest ${SECONDOPINION_RETAIN:-50} archived exchanges per repository)"; exit 0;;
            *) die "unknown prune option: $1";;
        esac; shift
    done
    retain="$(parse_count "--retain" "$retain")" || exit 1
    ensure_store
    [ -L "$TOMB" ] && die "refusing symlinked tombstones file: $TOMB"
    echo "mode=$([ "$apply" = 1 ] && echo apply || echo dry-run)"
    echo "retain=$retain"
    if [ "$apply" = 1 ] && [ -z "${PRUNE_ONLY_BUCKET:-}" ]; then
        # Sweep residue from removals interrupted after the rename below: a trash dir only
        # ever exists for an already-tombstoned exchange, so removing it is always safe.
        # (Skipped in bucket-scoped auto-prune, which stays minimal; manual prune sweeps.)
        local trash_res
        for trash_res in "$ARCH"/.prune-trash.*; do
            [ -e "$trash_res" ] && [ ! -L "$trash_res" ] || continue
            rm -rf -- "$trash_res" 2>/dev/null || true
        done
    fi
    # GC crash litter in exchanges/: day-old meta-less orphan dirs and .new.* staging
    # (an interrupted `new`), plus day-old .*.tmp.* files inside live exchanges.
    # Store-wide, so skipped in bucket-scoped auto-prune.
    local gc_cutoff=$(( $(epoch) - 86400 )) gcd gcm
    [ -n "${PRUNE_ONLY_BUCKET:-}" ] || for gcd in "$EXCH"/.new.* "$EXCH"/*/; do
        gcd="${gcd%/}"; [ -e "$gcd" ] || continue; [ -L "$gcd" ] && continue
        case "$(basename "$gcd")" in
            .new.*) ;;
            *) [ -f "$gcd/meta" ] && continue; valid_id "$(basename "$gcd")" || continue;;
        esac
        gcm="$(stat -c %Y -- "$gcd" 2>/dev/null)"; { [ -n "$gcm" ] && [ "$gcm" -lt "$gc_cutoff" ]; } || continue
        printf 'gc=%s\trule=crash-litter(no meta, older than one day)\n' "$(basename "$gcd")"
        if [ "$apply" = 1 ]; then rm -rf -- "$gcd" 2>/dev/null || true; fi
    done
    if [ "$apply" = 1 ] && [ -d "$EXCH" ] && [ -z "${PRUNE_ONLY_BUCKET:-}" ]; then
        for gcd in "$EXCH"/*/; do
            gcd="${gcd%/}"; [ -f "$gcd/meta" ] || continue; [ -L "$gcd/.lock" ] && continue
            # Non-blocking: an exchange another process holds locked is skipped, not waited on.
            ( exec 9>>"$gcd/.lock" 2>/dev/null && flock -n 9 \
              && find "$gcd" -maxdepth 1 -name '.*.tmp.*' -type f -mmin +1440 -delete 2>/dev/null ) || true
        done
    fi
    local rows=() d id common key
    for d in "$ARCH"/*/; do
        d="${d%/}"; [ -e "$d" ] || continue
        real_dir "$d" || continue
        [ -f "$d/meta" ] && [ ! -L "$d/meta" ] || continue
        id="$(meta_get "$d" exchange_id)"; valid_id "$id" || continue
        [ "$id" = "$(basename "$d")" ] || continue
        common="$(meta_get "$d" git_common_dir)"
        { [ -n "$common" ] && [ "$common" != "(none)" ]; } || common="(non-git)"
        key="$(meta_get "$d" archived_utc)"; [ -n "$key" ] || key="$(meta_get "$d" created_utc)"; [ -n "$key" ] || key="0000-00-00T00:00:00Z"
        rows+=("${common}${US}${key}${US}${id}")
    done
    local candidates=0 pruned=0 skipped=0
    if [ "${#rows[@]}" -gt 0 ]; then
        local sorted bucket="" rank=0 b k i targets=()
        sorted="$(printf '%s\n' "${rows[@]}" | LC_ALL=C sort -t "$US" -k1,1 -k2,2r -k3,3r)"
        while IFS="$US" read -r b k i; do
            [ -n "$i" ] || continue
            if [ "$b" != "$bucket" ]; then bucket="$b"; rank=0; fi
            rank=$((rank+1))
            # PRUNE_ONLY_BUCKET (auto-prune from archive): act on one repository's bucket only.
            if [ -n "${PRUNE_ONLY_BUCKET:-}" ] && [ "$b" != "$PRUNE_ONLY_BUCKET" ]; then continue; fi
            [ "$rank" -gt "$retain" ] && targets+=("${b}${US}${i}${US}${rank}")
        done <<< "$sorted"
        local bytes
        for line in "${targets[@]+"${targets[@]}"}"; do
            IFS="$US" read -r b i rank <<< "$line"
            # An exchange another process holds locked is in an active transition: skip it.
            if [ -L "$ARCH/$i/.lock" ]; then echo "skipped=$i reason=symlinked-lock" >&2; skipped=$((skipped+1)); continue; fi
            if [ "$apply" = 1 ]; then
                # Acquire and HOLD the exchange lock through revalidation, tombstoning and
                # removal — a probe-then-release would leave a window in which another
                # process takes the lock while the directory is being deleted.
                if ! exec 7>>"$ARCH/$i/.lock" 2>/dev/null; then echo "skipped=$i reason=unlockable"; skipped=$((skipped+1)); continue; fi
                if ! flock -n 7; then exec 7>&-; echo "skipped=$i reason=locked"; skipped=$((skipped+1)); continue; fi
            elif ! ( exec 9>>"$ARCH/$i/.lock"; flock -n 9 ) 2>/dev/null; then
                echo "skipped=$i reason=locked"; skipped=$((skipped+1)); continue
            fi
            candidates=$((candidates+1))
            bytes="$(du -sb -- "$ARCH/$i" 2>/dev/null | cut -f1)"; [ -n "$bytes" ] || bytes=0
            printf 'prune=%s\tbucket=%s\trank=%s\trule=over-retain(keep %s newest per repository)\tbytes=%s\n' "$i" "$b" "$rank" "$retain" "$bytes"
            if [ "$apply" = 1 ]; then
                [ -n "${SECONDOPINION_TEST_PRUNE_PAUSE:-}" ] && sleep "$SECONDOPINION_TEST_PRUNE_PAUSE"
                if ! real_dir "$ARCH/$i"; then exec 7>&-; continue; fi   # re-verify under OUR lock
                ( umask 077; exec 8>>"$TOMB" ) 2>/dev/null || { exec 7>&-; die "cannot open tombstones file: $TOMB"; }
                exec 8>>"$TOMB"; flock 8; chmod 600 "$TOMB" 2>/dev/null || true
                grep -Fxq -- "$i" "$TOMB" || printf '%s\n' "$i" >> "$TOMB"
                sync -- "$TOMB" 2>/dev/null || true
                # Rename away under OUR lock before deleting: once the dir leaves $ARCH,
                # a concurrent lock() cannot recreate .lock on a fresh inode inside a
                # directory that is mid-removal (flock is per-inode; open uses O_CREAT).
                local trash="$ARCH/.prune-trash.$$.$i"
                if mv -T -- "$ARCH/$i" "$trash" 2>/dev/null; then rm -rf -- "$trash" 2>/dev/null || true
                else rm -rf -- "$ARCH/$i" 2>/dev/null || true; fi
                exec 8>&-; exec 7>&-
                # Count only VERIFIED removals; a survivor is reported, not miscounted.
                if [ -e "$ARCH/$i" ]; then echo "skipped=$i reason=removal-failed" >&2; skipped=$((skipped+1))
                else pruned=$((pruned+1)); fi
            fi
        done
        # Interrupted-apply repair: a tombstoned id whose directory still exists was caught
        # mid-removal; finish the removal on --apply regardless of retention rank.
        # (Store-wide, so skipped in bucket-scoped auto-prune.)
        if [ "$apply" = 1 ] && [ -f "$TOMB" ] && [ -z "${PRUNE_ONLY_BUCKET:-}" ]; then
            while IFS= read -r i; do
                valid_id "$i" || continue
                real_dir "$ARCH/$i" || continue
                [ -L "$ARCH/$i/.lock" ] && { echo "skipped=$i reason=symlinked-lock" >&2; skipped=$((skipped+1)); continue; }
                exec 7>>"$ARCH/$i/.lock" 2>/dev/null || { echo "skipped=$i reason=unlockable"; skipped=$((skipped+1)); continue; }
                if ! flock -n 7; then exec 7>&-; echo "skipped=$i reason=locked"; skipped=$((skipped+1)); continue; fi
                if real_dir "$ARCH/$i"; then
                    printf 'prune=%s\trule=completing-interrupted-prune\n' "$i"
                    local rtrash="$ARCH/.prune-trash.$$.$i"
                    if mv -T -- "$ARCH/$i" "$rtrash" 2>/dev/null; then rm -rf -- "$rtrash" 2>/dev/null || true
                    else rm -rf -- "$ARCH/$i" 2>/dev/null || true; fi
                    [ -e "$ARCH/$i" ] && { echo "skipped=$i reason=removal-failed" >&2; skipped=$((skipped+1)); } || pruned=$((pruned+1))
                fi
                exec 7>&-
            done < "$TOMB"
        fi
    fi
    echo "candidates=$candidates"
    echo "pruned=$pruned"
    echo "skipped=$skipped"
    [ "$apply" = 1 ] || echo "note=dry run: nothing was removed; re-run with --apply to remove the targets above"
    return 0
}

retention_note() { # git_common_dir -> stderr note when that archive bucket exceeds the bound
    local want="$1" retain="${SECONDOPINION_RETAIN:-50}" n=0 d c
    case "$retain" in ''|*[!0-9]*) return 0;; esac
    { [ -n "$want" ] && [ "$want" != "(none)" ]; } || want="(none)"
    for d in "$ARCH"/*/; do
        d="${d%/}"; [ -e "$d" ] || continue
        real_dir "$d" || continue
        [ -f "$d/meta" ] && [ ! -L "$d/meta" ] || continue
        c="$(meta_get "$d" git_common_dir)"; { [ -n "$c" ] && [ "$c" != "(none)" ]; } || c="(none)"
        [ "$c" = "$want" ] && n=$((n+1))
    done
    if [ "$n" -gt "$retain" ]; then
        echo "note=archive retention exceeded for this exchange's repository bucket ($n archived, retain $retain); run 'secondopinion prune' to review" >&2
    fi
    return 0
}

relocate_responder_log() { # id (archived) — move responder-logs/<id>.log into the archived
    # exchange and point meta at it. Idempotent repair: also called on re-archive. A log
    # problem must not fail the archive, but it is reported, never silent.
    local id="$1" src="$STORE/responder-logs/$1.log" dst="$ARCH/$1/responder.log"
    [ -f "$src" ] && [ ! -L "$src" ] || return 0
    if mv -f -- "$src" "$dst" 2>/dev/null; then
        chmod 600 "$dst" 2>/dev/null || true
        lock "$ARCH/$id"; meta_set "$ARCH/$id" responder_log "$dst"; unlock
    else
        echo "note=responder log could not be moved into the archive; it remains at $src" >&2
    fi
    return 0
}

cmd_cancel() {
    [ "$#" -eq 1 ] || die "usage: cancel ID"
    local id="$1"; require_id "$id"
    local dir; dir="$(exdir "$id")"
    local state pid st0
    lock "$dir"; state="$(meta_get "$dir" state)"; pid="$(meta_get "$dir" responder_pid)"; st0="$(meta_get "$dir" responder_starttime)"; unlock
    case "$state" in
        answered|archived) echo "exchange_id=$id"; echo "state=$state"; echo "cancelled=no"; echo "reason=already-$state: a valid answer is never demoted"; return 0;;
    esac
    [ -n "$pid" ] || die "no background responder recorded for $id (only 'ask --background' responders can be cancelled)"
    local cur; cur="$(proc_start "$pid")"
    if [ -z "$cur" ]; then
        echo "exchange_id=$id"; echo "state=$state"; echo "cancelled=no"; echo "reason=not-running (responder already exited)"; return 0
    fi
    [ "$cur" = "$st0" ] || die "refusing to kill pid $pid: recorded start time '$st0' does not match /proc ('$cur') — possible PID reuse"
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM -- "$pid" 2>/dev/null || true
    local i=0; while [ "$i" -lt 50 ] && [ -n "$(proc_start "$pid")" ]; do sleep 0.1; i=$((i+1)); done
    if [ -n "$(proc_start "$pid")" ]; then kill -KILL -- "-$pid" 2>/dev/null || true; sleep 0.2; fi
    lock "$dir"
    state="$(meta_get "$dir" state)"
    if [ "$state" = "answered" ]; then
        unlock; echo "exchange_id=$id"; echo "state=answered"; echo "cancelled=no"; echo "reason=the answer arrived while cancelling; it remains valid"; return 0
    fi
    meta_set "$dir" responder_cancelled_utc "$(now_utc)"
    unlock
    echo "exchange_id=$id"; echo "cancelled=yes"; echo "state=$state"
    echo "note=the exchange stays $state and can still be answered by another responder (or: secondopinion archive $id --force)"
    return 0
}

cmd_jobs() {
    # Repository-scoped job table (the comparator's status view): one line per exchange of
    # this repository — id, state, age, responder liveness, requested target.
    local want_common="" all=0 repo=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --all) all=1;;
            --repo) [ "$#" -ge 2 ] || die "--repo requires a path"; repo="$2"; shift;;
            -h|--help) echo "usage: jobs [--all | --repo PATH]   (default: exchanges of the current repository)"; exit 0;;
            *) die "unknown jobs option: $1";;
        esac; shift
    done
    if [ "$all" = 0 ]; then
        [ -n "$repo" ] || repo="$PWD"
        want_common="$(git_common_of "$repo")"
        [ -n "$want_common" ] || die "not inside a git repository: $repo (use --all, or --repo PATH)"
    fi
    ensure_store
    local d id state common age rstate now printed=0; now="$(epoch)"
    for d in "$EXCH"/*/; do
        d="${d%/}"; [ -e "$d" ] || continue
        real_dir "$d" || continue
        [ -f "$d/meta" ] && [ ! -L "$d/meta" ] || continue
        id="$(meta_get "$d" exchange_id)"; valid_id "$id" || continue
        state="$(meta_get "$d" state)"; common="$(meta_get "$d" git_common_dir)"
        if [ -n "$want_common" ] && [ "$common" != "$want_common" ]; then continue; fi
        local ce; ce="$(meta_get "$d" created_epoch)"
        if [ -n "$ce" ]; then age="$(human_age $(( now - ce )))"; else age="-"; fi
        rstate="$(responder_state "$d")"; [ -n "$rstate" ] || rstate="-"
        printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$state" "$age" "$rstate" "$(meta_get "$d" target)"
        printed=$((printed+1))
    done
    if [ "$printed" = 0 ]; then
        if [ -n "$want_common" ]; then echo "no exchanges for this repository; other repositories may have some: secondopinion jobs --all" >&2
        else echo "no exchanges in the store" >&2; fi
    fi
    [ -n "$want_common" ] && retention_note "$want_common"
    return 0
}

cmd_result() {
    [ "$#" -eq 1 ] || die "usage: result ID"
    local id="$1"; require_id "$id"
    local dir; dir="$(exdir "$id")"
    local state; state="$(meta_get "$dir" state)"
    if [ "$state" = "claimed" ] && [ -e "$dir/response.md" ] && [ ! -L "$dir/response.md" ]; then
        if try_rollforward "$dir" "$id"; then state="$(meta_get "$dir" state)"; fi
    fi
    case "$state" in
        answered|archived) cmd_read_response "$id";;
        *)
            { echo "exchange_id=$id"; echo "state=$state"
              local r lg; r="$(responder_state "$dir")"; [ -n "$r" ] && echo "responder=$r"
              lg="$(meta_get "$dir" responder_log)"; [ -n "$lg" ] && echo "responder_log=$lg"
            } >&2
            die "no validated answer yet (state=$state); wait with: secondopinion wait $id";;
    esac
}

auto_prune_enabled() { case "${SECONDOPINION_AUTO_PRUNE:-}" in ""|0|false|no) return 1;; *) return 0;; esac; }

auto_prune_after_archive() { # git_common_dir — bucket-only, fail-open: never fails the archive
    local common="$1" out rc=0 removed
    { [ -n "$common" ] && [ "$common" != "(none)" ]; } || common="(non-git)"
    out="$(PRUNE_ONLY_BUCKET="$common" cmd_prune --apply 2>&1)" || rc=$?
    if [ "$rc" != 0 ]; then
        echo "auto_prune=failed (the archive itself succeeded); prune manually: secondopinion prune --apply"
        printf '%s\n' "$out" | tail -2 | sed 's/^/auto_prune_detail: /' >&2
        return 0
    fi
    removed="$(printf '%s\n' "$out" | sed -n 's/^pruned=//p' | head -1)"
    echo "auto_prune=ok removed=${removed:-0} retain=${SECONDOPINION_RETAIN:-50}"
    return 0
}

cmd_archive() {
    local id="" force=0 auto_prune=0
    while [ "$#" -gt 0 ]; do case "$1" in --force) force=1;; --prune) auto_prune=1;; -h|--help) usage; exit 0;; *) positional id "$1";; esac; shift; done
    [ -n "$id" ] || die "usage: archive ID [--force] [--prune]"
    require_id "$id"
    [ -L "$EXCH/$id" ] || [ -L "$ARCH/$id" ] && die "refusing symlinked exchange directory: $id"
    if ! is_active "$id"; then
        is_archived "$id" && { relocate_responder_log "$id"; echo "exchange_id=$id"; echo "state=archived"; echo "note=already archived"; return 0; }
        die "unknown exchange: $id"
    fi
    local dir="$EXCH/$id"; check_components "$dir"
    ensure_store
    lock "$dir"
    # Same-device check BEFORE any mutation: on a cross-filesystem archive/, mv -T
    # degrades to a non-atomic copy+rm whose interruption poisons every later archive
    # of this ID (and a later prune of the partial copy would tombstone it).
    [ "$(stat -L -c %d -- "$dir" 2>/dev/null)" = "$(stat -L -c %d -- "$ARCH" 2>/dev/null)" ] \
        || { unlock; die "archive/ is on a different filesystem than the exchange (rename would degrade to a non-atomic copy); keep the store on one filesystem"; }
    local state; state="$(meta_get "$dir" state)"
    if [ "$state" != "archived" ]; then   # state=archived here means a previous archive was interrupted before the move
        if [ "$state" != "answered" ] && [ "$force" != 1 ]; then unlock; die "exchange not answered (state=$state); use --force to archive anyway"; fi
        [ -e "$ARCH/$id" ] && { unlock; die "archive target already exists: $ARCH/$id"; }
        meta_set "$dir" state archived archived_utc "$(now_utc)" archived_from_state "$state"
    fi
    if ! mv -T "$dir" "$ARCH/$id" 2>/dev/null; then
        # Roll the metadata back so the exchange stays usable and the retry is honest.
        local prev; prev="$(meta_get "$dir" archived_from_state)"; [ -n "$prev" ] || prev="$state"
        meta_set "$dir" state "$prev"
        unlock; die "failed to move exchange to archive; state restored to $prev"
    fi
    unlock
    relocate_responder_log "$id"
    local acommon; acommon="$(meta_get "$ARCH/$id" git_common_dir)"
    echo "exchange_id=$id"; echo "state=archived"; echo "archive_dir=$ARCH/$id"
    if [ "$auto_prune" = 1 ] || auto_prune_enabled; then auto_prune_after_archive "$acommon"; fi
    retention_note "$acommon"
}

main() {
    [ "$#" -gt 0 ] || { usage; exit 2; }
    local cmd="$1"; shift
    case "$cmd" in
        new) cmd_new "$@";;
        ask) cmd_ask "$@";;
        publish) cmd_publish "$@";;
        list) cmd_list "$@";;
        status) cmd_status "$@";;
        show) cmd_show "$@";;
        path) cmd_path "$@";;
        claim) cmd_claim "$@";;
        respond) cmd_respond "$@";;
        read-response) cmd_read_response "$@";;
        wait) cmd_wait "$@";;
        archive) cmd_archive "$@";;
        prune) cmd_prune "$@";;
        cancel) cmd_cancel "$@";;
        jobs) cmd_jobs "$@";;
        result) cmd_result "$@";;
        review) cmd_review "$@";;
        review-result) cmd_review_result "$@";;
        version|--version) echo "secondopinion $VERSION";;
        help|-h|--help) usage;;
        *) die "unknown command: $cmd (try --help)";;
    esac
}

# The exit on the SAME line as main is load-bearing: bash otherwise reads more of this
# file after main returns, at its old byte offset — so an in-place update of the script
# while an invocation is blocked (e.g. a dev-tree edit under a running `ask`) would be
# parsed as shell input and crash that invocation ("syntax error near unexpected token").
# With the paired exit, a running invocation never touches the script fd again.
main "$@"; exit
